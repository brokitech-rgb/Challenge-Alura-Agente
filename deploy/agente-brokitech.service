[Unit]
Description=Agente de Soporte Brokitech Turnos (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Challenge-Alura-Agente
EnvironmentFile=-/home/ubuntu/Challenge-Alura-Agente/.env
ExecStart=/home/ubuntu/Challenge-Alura-Agente/.venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --browser.gatherUsageStats=false
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
