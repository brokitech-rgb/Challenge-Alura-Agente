# ---- Proveedor del modelo de lenguaje ----
# El agente usa la API de DeepSeek, que es compatible con el SDK de OpenAI.
# Conseguí tu clave en https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-tu-clave-aca
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Si dejás DEEPSEEK_API_KEY vacío, la app arranca igual en MODO DEMO:
# responde con extractos textuales recuperados de los PDFs, sin llamar al LLM.

# ---- Parámetros del agente (opcionales) ----
AGENTE_TOP_K=5
AGENTE_TEMPERATURA=0.2
AGENTE_MAX_ITERACIONES=6
