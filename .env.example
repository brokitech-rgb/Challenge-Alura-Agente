GROQ_API_KEY=gsk_tu-clave-de-groq
LLM_MODEL=openai/gpt-oss-120b

# El agente habla con el modelo via el SDK de OpenAI, asi que sirve cualquier
# proveedor con API compatible. Se detecta solo segun que clave este cargada;
# LLM_PROVIDER fuerza uno en particular.
#
#   groq      GROQ_API_KEY       https://api.groq.com/openai/v1   (tier gratuito)
#   deepseek  DEEPSEEK_API_KEY   https://api.deepseek.com         (prepago)
#   openai    OPENAI_API_KEY     https://api.openai.com/v1
#
# LLM_PROVIDER=groq
# LLM_BASE_URL=
# LLM_MODEL=
#
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Sin ninguna clave la app arranca igual en MODO DEMO: responde con extractos
# textuales recuperados de los PDF, sin llamar al modelo.

# ---- Parametros del agente (opcionales) ----
AGENTE_TOP_K=5
AGENTE_TEMPERATURA=0.2
AGENTE_MAX_ITERACIONES=6
